# Copia este archivo como .env en la misma carpeta y completa tus datos.
# DB_HOST es solo el dominio o la IP, sin https:// ni mysql://.
DB_HOST="TU_HOST_MYSQL"
DB_PORT=3306
DB_USER="avnadmin"
DB_PASSWORD="TU_CONTRASENA"
DB_NAME="becas_app"

# Para un host remoto, TLS permanece activado.
# Si el proveedor exige un certificado CA, guarda el archivo y pon su ruta.
DB_SSL=true
DB_SSL_CA="./certificados/ca.pem"
# Ejemplo de ruta: DB_SSL_CA="C:/certificados/ca.pem"

# Si el proveedor exige certificados de cliente, completa ambas rutas.
DB_SSL_CERT=""
DB_SSL_KEY=""

# Puerto del servidor local de la aplicación, diferente al puerto de MySQL.
PORT=3000
