# Copiar a .env en la raíz. Nunca subir contraseñas al repositorio.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=becas_aplicacion
DB_PASSWORD=TU_CONTRASENA
DB_NAME=becas_app
DB_POOL_MAX=5
DB_QUEUE_MAX=50
DB_CONNECT_TIMEOUT=10000

# Para Aiven u otro proveedor remoto, mantener TLS y configurar su CA.
DB_SSL=true
DB_SSL_CA=
DB_SSL_CERT=
DB_SSL_KEY=

HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:3000
# En producción se requiere HTTPS y COOKIE_SECURE=true.
NODE_ENV=development
COOKIE_SECURE=false
