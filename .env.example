# Copiar a .env en la raíz. Nunca subir contraseñas al repositorio.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=becas_aplicacion
DB_PASSWORD=TU_CONTRASENA
DB_NAME=becas_db
DB_POOL_MAX=5
DB_QUEUE_MAX=50
DB_CONNECT_TIMEOUT=10000

# Para Aiven u otro proveedor remoto, mantener TLS y configurar su CA.
DB_SSL=true
DB_SSL_CA=
DB_SSL_CERT=
DB_SSL_KEY=

HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:3000
# En producción se requiere HTTPS y COOKIE_SECURE=true.
NODE_ENV=development
COOKIE_SECURE=false

# Correos de notificación al cambiar de etapa.
# CORREO_TRANSPORTE: smtp | archivo | desactivado.
# Sin SMTP_HOST, en desarrollo se guardan como HTML en correos-locales/; en producción quedan en la bandeja de salida.
# Ejemplo con Gmail (ver README, "Configurar Gmail"): descomenta y completa con tu cuenta y su contraseña de aplicación.
CORREO_TRANSPORTE=
# CORREO_REMITENTE="Becas Nacionales <tu.cuenta@gmail.com>"
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=tu.cuenta@gmail.com
# SMTP_PASSWORD=TU_CONTRASENA_DE_APLICACION
